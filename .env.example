# Needed for questions (the daily check doesn't call a model). Never commit the real value.
ANTHROPIC_API_KEY=
# Optional: Slack incoming webhook for the daily check; without it the job prints instead.
SLACK_WEBHOOK_URL=
# Optional (defaults in the README configuration table)
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
QUERY_TIMEOUT_S=3
MAX_QUESTIONS_PER_SESSION=20
RATE_LIMIT_PER_MINUTE=6
DAILY_QUESTION_CAP=300
DAILY_COST_CAP_USD=1.00
# Prices (USD per million tokens) used only for the app's daily cost cap; defaults are Claude Haiku 5.5's list price.
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.50
# Optional: where the redacted request log and daily counters are written (git-ignored)
LOG_DIR=logs
# Optional: shows a "Watch the 90-second demo" button in the sidebar
DEMO_VIDEO_URL=
